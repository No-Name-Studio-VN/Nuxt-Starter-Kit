  "group": "Foundation",
  "requires": ["server-core"],
  "dependencies": [
    "@nuxtjs/turnstile"
  ],
  "env": [
    "NUXT_TURNSTILE_SITE_KEY",
    "NUXT_TURNSTILE_SECRET_KEY"
