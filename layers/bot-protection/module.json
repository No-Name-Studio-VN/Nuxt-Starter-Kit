        "layers/bot-protection/app/widgets/TurnstileChallenge.vue",
        "layers/bot-protection/app/widgets/turnstile-widget.ts",
        "layers/bot-protection/i18n/locales/en.json",
        "layers/bot-protection/i18n/locales/vi.json",
        "layers/bot-protection/module.json",
        "layers/bot-protection/module.ts",
        "layers/bot-protection/nuxt.config.ts",
        "layers/bot-protection/server/middleware/botProtection.ts",
        "layers/bot-protection/server/providers/turnstile.ts",
        "layers/bot-protection/server/utils/botProtection.ts",
        "layers/bot-protection/shared/constants/turnstile.ts",
        "layers/bot-protection/types/botProtection.ts",
        "layers/bot-protection/README.md"
      ]
    }
  ]
