{
  "title": "Authentication",
  "description": "Sessions, password sign-in, and account pages.",
  "group": "Authentication",
  "requires": ["database", "email"],
  "dependencies": ["@nuxtjs/turnstile", "nuxt-auth-utils"],
  "env": [
    "NUXT_SESSION_PASSWORD",
    "CSRF_SECRET",
    "NUXT_TURNSTILE_SITE_KEY",
    "NUXT_TURNSTILE_SECRET_KEY"
  ]
}
