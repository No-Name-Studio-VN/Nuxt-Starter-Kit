{
  "title": "Authentication",
  "description": "Accounts, sessions and the sign-in page that sign-in methods plug into.",
  "group": "Authentication",
  "requires": ["server-core", "database"],
  "requiresOneOf": ["auth-password", "auth-oauth"],
  "dependencies": ["nuxt-auth-utils"],
  "env": ["NUXT_APP_SECRET"],
  "changes": [
    {
      "id": "auth.onboarding-and-sign-in-lint",
      "since": "4.1.3",
      "title": "Fix directive ordering in onboarding and consolidate sign-in policy type imports.",
      "kind": "fix",
      "files": [
        "layers/auth/module.json",
        "layers/auth/app/pages/onboarding.vue",
        "layers/auth/server/utils/completeSignIn.ts"
      ]
    },
    {
      "id": "auth.localized-sign-in-feedback",
      "since": "4.2.0",
      "title": "Localize sign-in, account navigation, and onboarding. Review customized login copy and let sign-in feedback resolve translation keys at render time.",
      "kind": "feature",
      "files": [
        "layers/auth/app/components/auth/AuthPageLayout.vue",
        "layers/auth/app/components/nav/DashboardSignIn.vue",
        "layers/auth/app/components/nav/NavUser.vue",
        "layers/auth/app/components/onboarding/UsernameStep.vue",
        "layers/auth/app/pages/auth/index.vue",
        "layers/auth/app/pages/auth/login.vue",
        "layers/auth/app/plugins/nav.ts",
        "layers/auth/i18n/locales/en.json",
        "layers/auth/i18n/locales/vi.json",
        "layers/auth/module.json",
        "layers/auth/shared/constants/authMessages.ts"
      ]
    },
    {
      "id": "auth.account-prerender-exclusions",
      "since": "4.2.0",
      "title": "Exclude sign-in, settings, and onboarding—including localized sign-in routes—from static prerendering.",
      "kind": "fix",
      "files": ["layers/auth/nuxt.config.ts"]
    }
  ]
}
