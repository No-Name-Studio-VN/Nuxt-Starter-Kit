# <nsk:auth>
NUXT_SESSION_PASSWORD=random-pass
# </nsk:auth>
NUXT_PUBLIC_SITE_URL=nnsvn.me

NUXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=sntrys_ey...

# <nsk:auth>
CSRF_SECRET=random-secret
# </nsk:auth>

# dont put nuxt prefix to nuxt studio environment variables
# <nsk:content>
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# </nsk:content>

# <nsk:auth>
NUXT_TURNSTILE_SITE_KEY=0x4A...
NUXT_TURNSTILE_SECRET_KEY=0x4A...
# </nsk:auth>

# <nsk:admin>
NUXT_DEFAULT_ADMIN_PASSWORD=your-default-admin-password

# Guards the database seed endpoint (server/api/admin/seed.post.ts)
NUXT_SEED_SECRET=random-secret
# </nsk:admin>

# <nsk:auth>
# Transactional email, used by password reset and account verification
NUXT_RESEND_API_KEY=re_...
NUXT_RESEND_FROM_EMAIL=noreply@example.com

# Google OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# </nsk:auth>
