# Stable secret for sealing sessions. Generate with: openssl rand -base64 32
NUXT_APP_SECRET=
NUXT_PUBLIC_SITE_URL=nnsvn.me

NUXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=sntrys_ey...

# dont put nuxt prefix to nuxt studio environment variables
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

NUXT_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# Guards the database seed endpoint (layers/admin/server/api/admin/seed.post.ts)
NUXT_SEED_SECRET=random-secret

# Transactional email, used by password reset and account verification
NUXT_RESEND_API_KEY=re_...
NUXT_RESEND_FROM_EMAIL=noreply@example.com

# Google OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Discord OAuth
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# OpenID Connect (the provider's discovery URL, e.g. https://issuer.example/.well-known/openid-configuration)
NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=
NUXT_OAUTH_OIDC_OPENID_CONFIG=
