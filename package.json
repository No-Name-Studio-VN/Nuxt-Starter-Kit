    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.1",
    "@nuxtjs/turnstile": "^1.1.3",
    "@openfeature/server-sdk": "^1.23.0",
    "@pinia/nuxt": "^1.0.3",
    "@sentry/nuxt": "^11.8.0",
