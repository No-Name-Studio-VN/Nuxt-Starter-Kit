{
  "name": "nuxt-starter-kit",
  "version": "2.3.0",
  "private": true,
  "description": "A Nuxt 4 starter template with NuxtHub, Auth, and PWA support",
  "author": {
    "name": "No Name Studio",
    "email": "contact@nnsvn.me"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare && NODE_OPTIONS=--max-old-space-size=12288 nuxt build",
    "clean": "rm -r .nuxt && rm -r .output",
    "db:generate": "pnpm exec nuxt db generate",
    "db:seed": "nitro task run db:admin-creation",
    "deploy": "pnpm exec wrangler deploy && pnpm exec wrangler d1 migrations apply DB --remote",
    "dev": "pnpm run prepare && nuxt dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "postinstall": "nuxt prepare",
    "prepare": "pwa-assets-generator && husky",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.18.0",
    "@lucide/vue": "^1.60.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.0.1",
