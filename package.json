{
  "name": "nuxt-starter-kit",
  "version": "2.0",
  "private": true,
  "description": "A Nuxt 4 starter template with NuxtHub, Auth, and PWA support",
  "author": {
    "name": "No Name Studio",
    "email": "contact@nnsvn.me"
  },
  "type": "module",
  "scripts": {
    "build": "npm run prepare && npm run prepare && NODE_OPTIONS=--max-old-space-size=12288 nuxt build",
    "clean": "rm -r .nuxt && rm -r .output",
    "db:generate": "npx nuxt db generate",
    "db:seed": "nitro task run db:admin-creation",
    "deploy": "npx wrangler deploy && npx wrangler d1 migrations apply DB --remote",
    "dev": "npm run prepare && nuxt dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "postinstall": "nuxt prepare",
    "prepare": "pwa-assets-generator && husky",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/vue": "^1.28.0",
    "@nuxt/content": "^3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.10",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.1",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^1.0.1",
    "@sentry/nuxt": "^10.69.0",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@tanstack/vue-table": "^9.0.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "@unhead/vue": "^2.1.13",
    "@vee-validate/nuxt": "^5.0.0-beta.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "es-toolkit": "^1.50.0",
    "feed": "^6.0.0",
    "jszip": "^3.10.1",
    "luxon": "^3.7.2",
    "minisearch": "^7.2.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-component-meta": "^0.18.0",
    "nuxt-content-git": "^7.0.0",
    "nuxt-security": "^2.6.0",
    "nuxt-studio": "^1.7.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.39",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "vue3-simple-icons": "^16.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.3",
    "@types/node": "^25.5.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-oxlint": "^1.77.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "nuxt-content-git": "^7.0.0",
