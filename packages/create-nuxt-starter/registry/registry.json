{
  "schemaVersion": 2,
  "version": "0.3.0",
  "kit": {
    "template": "github:No-Name-Studio-VN/Nuxt-Starter-Kit",
    "revision": "2f7f65d"
  },
  "exclude": [
    "packages/**",
    "docs/superpowers/**",
    "CLAUDE.MD",
    ".whitesource",
    ".github/workflows/release.yml",
    "package-lock.json"
  ],
  "modules": [
    {
      "id": "base",
      "title": "Base",
      "description": "Nuxt 4 foundation: UI kit, theming, i18n, SEO, and security.",
      "version": "0.3.0",
      "paths": [
        ".editorconfig",
        ".env.example",
        ".gitattributes",
        ".gitignore",
        ".ignore",
        ".nuxtrc",
        ".oxfmtrc.jsonc",
        ".oxlintrc.jsonc",
        ".github/workflows/lint-check.yml",
        ".husky/**",
        ".vscode/**",
        "README.md",
        "auth.d.ts",
        "commitlint.config.js",
        "components.json",
        "content.config.ts",
        "docs.config.ts",
        "eslint.config.js",
        "i18n-constants.ts",
        "lint-staged.config.js",
        "nuxt.config.ts",
        "package.json",
        "pwa-assets.config.ts",
        "sentry.client.config.ts",
        "tsconfig.json",
        "vitest.config.ts",
        "wrangler.jsonc",
        "app/**",
        "content/**",
        "i18n/**",
        "public/**",
        "server/**",
        "shared/**",
        "types/**"
      ],
      "notes": [
        "Configure Cloudflare D1 and KV bindings before deploying.",
        "Replace the Sentry, OAuth, Turnstile, and Studio placeholders with your own settings."
      ]
    }
  ]
}
