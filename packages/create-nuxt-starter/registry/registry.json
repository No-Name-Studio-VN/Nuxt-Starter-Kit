{
  "schemaVersion": 2,
  "version": "0.3.0",
  "kit": {
    "template": "github:No-Name-Studio-VN/Nuxt-Starter-Kit",
    "revision": "2f7f65d"
  },
  "exclude": [
    "packages/**",
    "docs/superpowers/**",
    "CLAUDE.MD",
    ".whitesource",
    ".github/workflows/release.yml",
    "package-lock.json"
  ],
  "modules": [
    {
      "id": "base",
      "title": "Base",
      "description": "Nuxt 4 foundation: UI kit, theming, i18n, SEO, and security.",
      "version": "0.3.0",
      "paths": [
        ".editorconfig",
        ".env.example",
        ".gitattributes",
        ".gitignore",
        ".ignore",
        ".nuxtrc",
        ".oxfmtrc.jsonc",
        ".oxlintrc.jsonc",
        ".github/workflows/lint-check.yml",
        ".husky/**",
        ".vscode/**",
        "README.md",
        "auth.d.ts",
        "commitlint.config.js",
        "components.json",
        "content.config.ts",
        "docs.config.ts",
        "eslint.config.js",
        "i18n-constants.ts",
        "lint-staged.config.js",
        "nuxt.config.ts",
        "package.json",
        "sentry.client.config.ts",
        "tsconfig.json",
        "vitest.config.ts",
        "wrangler.jsonc",
        "app/app.vue",
        "app/error.vue",
        "app/assets/**",
        "app/components/**",
        "app/composables/**",
        "app/constants/**",
        "app/layouts/**",
        "app/lib/**",
        "app/middleware/**",
        "app/modules/**",
        "app/pages/**",
        "app/plugins/**",
        "app/stores/**",
        "app/utils/**",
        "content/**",
        "i18n/**",
        "public/**",
        "server/**",
        "shared/**",
        "types/**"
      ],
      "structured": {
        "package.json": {
          "scripts": {
            "prepare": "husky"
          }
        }
      },
      "notes": [
        "Configure Cloudflare D1 and KV bindings before deploying.",
        "Replace the Sentry, OAuth, Turnstile, and Studio placeholders with your own settings."
      ]
    },
    {
      "id": "pwa",
      "title": "PWA",
      "description": "Installable app: service worker, offline fallback, and install prompt.",
      "version": "0.3.0",
      "requires": ["base"],
      "paths": [
        "pwa-assets.config.ts",
        "app/service-worker/**",
        "app/components/InstallPrompter.vue",
        "app/pages/~offline.vue"
      ],
      "structured": {
        "package.json": {
          "scripts": {
            "prepare": "pwa-assets-generator && husky"
          },
          "dependencies": {
            "@vite-pwa/nuxt": "^1.1.1"
          },
          "devDependencies": {
            "@vite-pwa/assets-generator": "^1.0.2"
          }
        }
      },
      "notes": [
        "Icons in public/ are generated by pwa-assets-generator — re-run \"npm run prepare\" after replacing public/favicon.svg."
      ]
    }
  ]
}
