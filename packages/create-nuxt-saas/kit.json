{
  "groups": ["Foundation", "Authentication", "App", "Content"],
  "exclude": [
    "packages/**",
    "docs/**",
    "tests/**",
    "test/**/*.test.ts",
    "test/**/*.spec.ts",
    "test/**/*.test.mjs",
    "test/**/*.spec.mjs",
    "test/**/*.test.js",
    "test/**/*.spec.js",
    "CLAUDE.MD",
    "CLAUDE.md",
    ".claude/**",
    ".serena/**",
    ".whitesource",
    ".github/workflows/release.yml",
    ".github/workflows/cli-matrix.yml",
    ".github/workflows/cli-release.yml",
    "pnpm-lock.yaml",
    "server/db/migrations/**",
    "layers/content/public/_redirects",
    ".husky/_/**",
    ".superpowers/**",
    ".slim/**",
    ".ignore"
  ],
  "userOwned": [
    "package.json",
    "wrangler.jsonc",
    ".env.example",
    "README.md",
    "site.config.ts",
    "i18n/**",
    "public/**"
  ],
  "changes": [
    {
      "id": "base.form-challenges",
      "since": "4.0.0",
      "title": "Expose form challenges without requiring an auth or server layer.",
      "kind": "feature",
      "files": [
        ".env.example",
        "README.md",
        "app/components/ExtensionSlot.vue",
        "app/components/FormChallenge.vue",
        "app/composables/useFormChallenge.ts",
        "layers/auth-email-verification/app/pages/auth/verify-email.vue",
        "layers/auth-email-verification/nuxt.config.ts",
        "shared/constants/formChallenge.ts",
        "types/botProtection.ts",
        "types/extensions.ts"
      ]
    },
    {
      "id": "base.d1-bulk-delete",
      "since": "4.0.0",
      "title": "Keep large SQLite deletes within D1’s parameter limit in one statement.",
      "kind": "fix",
      "files": [
        "layers/auth/server/utils/database/user.ts",
        "layers/auth/server/utils/database/userLockScreen.ts",
        "layers/auth-2fa/server/utils/database/userTwoFactor.ts",
        "layers/database/server/utils/databaseValues.ts",
        "layers/feature-flags/server/utils/database/featureFlag.ts"
      ]
    },
    {
      "id": "base.worker-hydration",
      "since": "4.0.0",
      "title": "Restore async auth and PWA components in Cloudflare SSR and prevent installed-state hydration mismatches.",
      "kind": "fix",
      "files": [
        "layers/auth/app/components/auth/AuthPageLayout.vue",
        "layers/pwa/app/components/InstallPrompter.vue",
        "layers/pwa/app/plugins/extensions.ts"
      ]
    },
    {
      "id": "content.scaffold-examples",
      "since": "4.0.0",
      "title": "Use working password-module selections in installation examples.",
      "kind": "fix",
      "files": [
        "content/docs/1.getting-started/1.introduction.md",
        "content/docs/1.getting-started/2.installation.md"
      ]
    },
    {
      "id": "base.seo-charset",
      "since": "4.0.1",
      "title": "Remove redundant charset meta from seo config so nuxt-seo-utils does not warn.",
      "kind": "fix",
      "files": ["nuxt.config.ts"]
    },
    {
      "id": "base.kit-4-0-1",
      "since": "4.0.1",
      "title": "Bump kit package version to 4.0.1.",
      "kind": "feature",
      "files": ["package.json"]
    },
    {
      "id": "base.apple-card-carousel-short-screen",
      "since": "4.1.0",
      "title": "Opt into shorter Apple card carousel sizing with the shortScreen prop; defaults stay unchanged.",
      "kind": "feature",
      "files": [
        "app/components/ui/apple-card-carousel/AppleCard.vue",
        "app/components/ui/apple-card-carousel/AppleCardCarousel.vue",
        "app/components/ui/apple-card-carousel/AppleCarouselContext.ts"
      ]
    },
    {
      "id": "base.kit-4-1-0",
      "since": "4.1.0",
      "title": "Bump kit package version to 4.1.0.",
      "kind": "feature",
      "files": ["package.json"]
    },
    {
      "id": "base.global-data-table",
      "since": "4.1.1",
      "title": "Use the shared DataTable without installing the admin layer.",
      "kind": "feature",
      "files": ["app/components/DataTable.vue", "i18n/locales/en.json", "i18n/locales/vi.json"]
    },
    {
      "id": "base.kit-4-1-1",
      "since": "4.1.1",
      "title": "Bump kit package version to 4.1.1.",
      "kind": "fix",
      "files": ["package.json"]
    }
  ]
}
